# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=etl_warehouse
POSTGRES_USER=etl_user
POSTGRES_PASSWORD=etl_password

# MongoDB Configuration
MONGO_PORT=27018
MONGO_URI=mongodb://etl_user:etl_password@localhost:27018/etl_events?authSource=admin
MONGO_DB=etl_events

# Security & PII Masking
PII_HASH_SALT=prod-grade-sha256-salt-replace-in-prod

# Pipeline Execution Settings
BATCH_SIZE=2000
LOG_LEVEL=INFO
QUARANTINE_THRESHOLD_PCT=20.0
